<UserControl
    x:Class="Screenbox.Controls.PlayerElement"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vlcSharp="using:Screenbox.Controls"
    d:DesignHeight="300"
    d:DesignWidth="400"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid
        Background="{x:Bind Background, Mode=OneWay}"
        BorderBrush="{x:Bind BorderBrush, Mode=OneWay}"
        BorderThickness="{x:Bind BorderThickness, Mode=OneWay}"
        CornerRadius="{x:Bind CornerRadius, Mode=OneWay}">
        <!--  Fake button for interaction. Can "Click" but cannot receive focus  -->
        <UserControl
            x:Name="VideoViewButton"
            Margin="{x:Bind ButtonMargin, Mode=OneWay}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AllowFocusOnInteraction="False"
            DoubleTapped="VideoViewButton_OnDoubleTapped"
            IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
            ManipulationCompleted="VideoViewButton_OnManipulationCompleted"
            ManipulationDelta="VideoViewButton_ManipulationDelta"
            ManipulationMode="TranslateX,TranslateY"
            PointerCanceled="VideoViewButton_OnPointerCanceled"
            PointerMoved="VideoViewButton_OnPointerMoved"
            PointerPressed="VideoViewButton_OnPointerPressed"
            PointerReleased="VideoViewButton_OnPointerReleased"
            PointerWheelChanged="VideoViewButton_OnPointerWheelChanged"
            Tapped="VideoViewButton_OnTapped">
            <Border Background="Transparent" />
        </UserControl>

        <vlcSharp:VideoView
            x:Name="VlcVideoView"
            Canvas.ZIndex="0"
            FlowDirection="LeftToRight"
            Initialized="VlcVideoView_OnInitialized"
            IsHitTestVisible="False"
            KeyboardAcceleratorPlacementMode="Hidden"
            MediaPlayer="{x:Bind ViewModel.VlcPlayer, Mode=OneWay}"
            SizeChanged="VlcVideoView_OnSizeChanged" />
        <MediaPlayerElement
            x:Name="ColorVideoView"
            AreTransportControlsEnabled="False"
            AutoPlay="False"
            Canvas.ZIndex="1"
            FlowDirection="LeftToRight"
            IsHitTestVisible="False"
            Stretch="Uniform"
            Visibility="Collapsed" />
        <!--  Text subtitles use their own clock and never reopen the decoding source.  -->
        <Border
            x:Name="SubtitleOverlay"
            MaxWidth="1400"
            Margin="24,0,24,52"
            Padding="8,4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#99000000"
            Canvas.ZIndex="2"
            CornerRadius="4"
            IsHitTestVisible="False"
            Visibility="{x:Bind ViewModel.HasSubtitleText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock
                FontSize="{x:Bind ViewModel.SubtitleFontSize, Mode=OneWay}"
                FontWeight="SemiBold"
                Foreground="White"
                MaxLines="6"
                Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}"
                TextAlignment="Center"
                TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
