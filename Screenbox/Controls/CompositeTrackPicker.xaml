<UserControl
    x:Class="Screenbox.Controls.CompositeTrackPicker"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedVisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:behaviors="using:Screenbox.Behaviors"
    xmlns:contract14Present="http://schemas.microsoft.com/winfx/2006/xaml/presentation?IsApiContractPresent(Windows.Foundation.UniversalApiContract,14)"
    xmlns:controls="using:Screenbox.Controls"
    xmlns:ctConverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="using:Screenbox.Core.Enums"
    xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:strings="using:Screenbox.Strings"
    d:DesignHeight="492"
    d:DesignWidth="224"
    mc:Ignorable="d">
    <UserControl.Resources>
        <ctConverters:DoubleToVisibilityConverter x:Key="GreaterThanZeroVisibilityConverter" GreaterThan="0" />

        <DataTemplate x:Key="MediaTrackItemDataTemplate" x:DataType="x:String">
            <TextBlock
                HorizontalTextAlignment="DetectFromContent"
                Text="{x:Bind}"
                TextTrimming="{StaticResource MenuFlyoutItemTextTrimming}">
                <interactivity:Interaction.Behaviors>
                    <behaviors:OverflowTextToolTipBehavior />
                </interactivity:Interaction.Behaviors>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Width="224">
        <!--#region Composite-->
        <StackPanel x:Name="CompositePanel" Orientation="Vertical">
            <!--  Video tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind VideoDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.VideoTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False"
                Visibility="{x:Bind ViewModel.VideoTracks.Count, Mode=OneWay, Converter={StaticResource GreaterThanZeroVisibilityConverter}}">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Video}"
                            TextWrapping="NoWrap" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <MenuFlyoutSeparator IsTabStop="False" />
                </ListView.Footer>
            </ListView>
            <!--  Audio tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind AudioDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.AudioTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Audio}"
                            TextWrapping="NoWrap">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>

                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="{StaticResource HyperlinkButtonUniformPadding}"
                            contract14Present:AutomationProperties.AutomationControlType="Button"
                            AutomationProperties.Name="{x:Bind strings:Resources.AudioOptions}"
                            Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                            CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Audio}"
                            Content="{x:Bind strings:Resources.Options}"
                            FontSize="{StaticResource CaptionTextBlockFontSize}" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <MenuFlyoutSeparator IsTabStop="False" />
                </ListView.Footer>
            </ListView>
            <!--  Subtitle tracks  -->
            <ListView
                ItemContainerTransitions="{x:Null}"
                ItemTemplate="{StaticResource MediaTrackItemDataTemplate}"
                ItemsSource="{x:Bind SubtitleDisplayList}"
                ScrollViewer.VerticalScrollMode="Disabled"
                SelectedIndex="{x:Bind ViewModel.SubtitleTrackIndex, Mode=TwoWay}"
                SelectionMode="Single"
                SingleSelectionFollowsFocus="False">
                <ListView.Header>
                    <Grid MinHeight="{StaticResource ListViewItemMinHeight}" Margin="16,0,4,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind strings:Resources.Subtitles}"
                            TextWrapping="NoWrap">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:OverflowTextToolTipBehavior />
                            </interactivity:Interaction.Behaviors>
                        </TextBlock>

                        <HyperlinkButton
                            Grid.Column="1"
                            Padding="{StaticResource HyperlinkButtonUniformPadding}"
                            contract14Present:AutomationProperties.AutomationControlType="Button"
                            AutomationProperties.Name="{x:Bind strings:Resources.SubtitleOptions}"
                            Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                            CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Subtitle}"
                            Content="{x:Bind strings:Resources.Options}"
                            FontSize="{StaticResource CaptionTextBlockFontSize}" />
                    </Grid>
                </ListView.Header>
                <ListView.Footer>
                    <ListViewItem
                        AutomationProperties.Name="{x:Bind strings:Resources.AddSubtitle, Mode=OneTime}"
                        KeyUp="AddSubtitleListViewFooterItem_OnKeyUp"
                        Tapped="AddSubtitleListViewFooterItem_OnTapped">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <muxc:ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind ViewModel.AddSubtitleCommand.IsRunning, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.AddSubtitleCommand.IsRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{x:Bind strings:Resources.AddSubtitle, Mode=OneTime}" />
                        </StackPanel>
                    </ListViewItem>
                </ListView.Footer>
            </ListView>
            <!--  Subtitle synchronization is available without opening a second options page.  -->
            <Grid Margin="12,8,12,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Margin="0,0,0,6"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind strings:Resources.TimingOffset, Mode=OneTime}" />
                <TextBlock
                    Grid.Column="1"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="ms" />
                <muxc:NumberBox
                    x:Name="SubtitleTimingOffsetBox"
                    Grid.Row="1"
                    AutomationProperties.Name="{x:Bind strings:Resources.TimingOffset, Mode=OneTime}"
                    LargeChange="1000"
                    Maximum="{x:Bind controls:CompositeTrackPicker.SubtitleTimingOffsetMax, Mode=OneTime}"
                    Minimum="{x:Bind controls:CompositeTrackPicker.SubtitleTimingOffsetMin, Mode=OneTime}"
                    SmallChange="50"
                    SpinButtonPlacementMode="Compact"
                    Value="{x:Bind PlaybackSession.SubtitleTimingOffset, Mode=TwoWay}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="1"
                    MinWidth="32"
                    Margin="4,0,0,0"
                    Padding="6,0"
                    AutomationProperties.Name="{x:Bind strings:Resources.Default, Mode=OneTime}"
                    Command="{x:Bind PlaybackSession.ResetSubtitleTimingOffsetCommand, Mode=OneTime}"
                    Content="0"
                    ToolTipService.ToolTip="{x:Bind strings:Resources.Default, Mode=OneTime}" />
            </Grid>
        </StackPanel>
        <!--#endregion-->

        <!--#region Audio Options-->
        <Grid
            x:Name="AudioOptionsGrid"
            AutomationProperties.Name="{x:Bind strings:Resources.AudioOptions}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Width="{StaticResource NavigationBackButtonWidth}"
                Height="{StaticResource NavigationBackButtonWidth}"
                Margin="4,2,4,2"
                Padding="0"
                AutomationProperties.Name="{x:Bind strings:Resources.Back}"
                BorderThickness="0"
                Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Composite}"
                FontSize="16"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.Back}">
                <muxc:AnimatedIcon
                    Width="16"
                    Height="16"
                    MirroredWhenRightToLeft="True">
                    <animatedVisuals:AnimatedBackVisualSource />
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:FontIconSource
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>

            <TextBlock
                Grid.Row="0"
                Margin="48,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Bind strings:Resources.Audio}" />

            <!--  Offset  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,12,16,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind strings:Resources.TimingOffset}" />

            <Grid
                Grid.Row="2"
                Padding="12,0"
                FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <RepeatButton
                    x:Name="DecreaseAudioTimingOffsetButton"
                    Grid.Column="0"
                    MinWidth="32"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind strings:Resources.DecreaseValue(strings:Resources.TimingOffset)}"
                    Background="{ThemeResource SubtleButtonBackground}"
                    BorderThickness="0"
                    Click="DecreaseAudioTimingOffsetButton_OnClick"
                    Content="&#xF8AB;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    IsTextScaleFactorEnabled="False" />

                <Slider
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    AutomationProperties.Name="{x:Bind strings:Resources.TimingOffset}"
                    IsThumbToolTipEnabled="False"
                    Maximum="{x:Bind controls:CompositeTrackPicker.TimingOffsetMax}"
                    Minimum="{x:Bind controls:CompositeTrackPicker.TimingOffsetMin}"
                    SmallChange="25"
                    StepFrequency="{x:Bind controls:CompositeTrackPicker.TimingOffsetStep}"
                    Value="{x:Bind PlaybackSession.AudioTimingOffset, Mode=TwoWay}" />

                <RepeatButton
                    x:Name="IncreaseAudioTimingOffsetButton"
                    Grid.Column="2"
                    MinWidth="32"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind strings:Resources.IncreaseValue(strings:Resources.TimingOffset)}"
                    Background="{ThemeResource SubtleButtonBackground}"
                    BorderThickness="0"
                    Click="IncreaseAudioTimingOffsetButton_OnClick"
                    Content="&#xF8AA;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    IsTextScaleFactorEnabled="False" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="12,8,12,11"
                HorizontalAlignment="Center"
                Typography.NumeralAlignment="Tabular"><Run Text="{x:Bind PlaybackSession.AudioTimingOffset, Mode=OneWay}" /> <Run Text="ms" /></TextBlock>
        </Grid>
        <!--#endregion-->

        <!--#region Subtitle Options-->
        <Grid
            x:Name="SubtitleOptionsGrid"
            AutomationProperties.Name="{x:Bind strings:Resources.SubtitleOptions}"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                Grid.Row="0"
                Width="{StaticResource NavigationBackButtonWidth}"
                Height="{StaticResource NavigationBackButtonWidth}"
                Margin="4,2,4,2"
                Padding="0"
                AutomationProperties.Name="{x:Bind strings:Resources.Back}"
                BorderThickness="0"
                Command="{x:Bind ViewModel.SetDisplayModeCommand}"
                CommandParameter="{x:Bind enums:TrackPickerDisplayMode.Composite}"
                FontSize="16"
                Style="{StaticResource SubtleButtonStyle}"
                ToolTipService.ToolTip="{x:Bind strings:Resources.Back}">
                <muxc:AnimatedIcon
                    Width="16"
                    Height="16"
                    MirroredWhenRightToLeft="True">
                    <animatedVisuals:AnimatedBackVisualSource />
                    <muxc:AnimatedIcon.FallbackIconSource>
                        <muxc:FontIconSource
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Glyph="&#xE72B;"
                            MirroredWhenRightToLeft="True" />
                    </muxc:AnimatedIcon.FallbackIconSource>
                </muxc:AnimatedIcon>
            </Button>

            <TextBlock
                Grid.Row="0"
                Margin="48,0,8,0"
                VerticalAlignment="Center"
                Text="{x:Bind strings:Resources.Subtitles}" />

            <!--  Offset  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,12,16,8"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="{x:Bind strings:Resources.TimingOffset}" />

            <Grid
                Grid.Row="2"
                Margin="12,0"
                FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <RepeatButton
                    x:Name="DecreaseSubtitleTimingOffsetButton"
                    Grid.Column="0"
                    MinWidth="32"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind strings:Resources.DecreaseValue(strings:Resources.TimingOffset)}"
                    Background="{ThemeResource SubtleButtonBackground}"
                    BorderThickness="0"
                    Click="DecreaseSubtitleTimingOffsetButton_OnClick"
                    Content="&#xF8AB;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    IsTextScaleFactorEnabled="False" />

                <muxc:NumberBox
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    AutomationProperties.Name="{x:Bind strings:Resources.TimingOffset, Mode=OneTime}"
                    LargeChange="1000"
                    Maximum="{x:Bind controls:CompositeTrackPicker.SubtitleTimingOffsetMax, Mode=OneTime}"
                    Minimum="{x:Bind controls:CompositeTrackPicker.SubtitleTimingOffsetMin, Mode=OneTime}"
                    SmallChange="50"
                    SpinButtonPlacementMode="Hidden"
                    Value="{x:Bind PlaybackSession.SubtitleTimingOffset, Mode=TwoWay}" />

                <RepeatButton
                    x:Name="IncreaseSubtitleTimingOffsetButton"
                    Grid.Column="2"
                    MinWidth="32"
                    Padding="0"
                    VerticalAlignment="Stretch"
                    AutomationProperties.Name="{x:Bind strings:Resources.IncreaseValue(strings:Resources.TimingOffset)}"
                    Background="{ThemeResource SubtleButtonBackground}"
                    BorderThickness="0"
                    Click="IncreaseSubtitleTimingOffsetButton_OnClick"
                    Content="&#xF8AA;"
                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                    FontSize="{StaticResource CaptionTextBlockFontSize}"
                    IsTextScaleFactorEnabled="False" />
            </Grid>

            <TextBlock
                Grid.Row="3"
                Margin="12,8,12,11"
                HorizontalAlignment="Center"
                Typography.NumeralAlignment="Tabular"><Run Text="{x:Bind PlaybackSession.SubtitleTimingOffset, Mode=OneWay}" /> <Run Text="ms" /></TextBlock>
        </Grid>
        <!--#endregion-->

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="DisplayModeStates">
                <VisualState x:Name="CompositeOptionsVisible" />

                <VisualState x:Name="AudioOptionsVisible">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsTrackPickerDisplayMode(ViewModel.DisplayMode, enums:TrackPickerDisplayMode.Audio), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompositePanel.Visibility" Value="Collapsed" />
                        <Setter Target="AudioOptionsGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation FromHorizontalOffset="224" TargetName="AudioOptionsGrid" />
                    </Storyboard>
                </VisualState>

                <VisualState x:Name="SubtitleOptionsVisible">
                    <VisualState.StateTriggers>
                        <StateTrigger IsActive="{x:Bind IsTrackPickerDisplayMode(ViewModel.DisplayMode, enums:TrackPickerDisplayMode.Subtitle), Mode=OneWay}" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="CompositePanel.Visibility" Value="Collapsed" />
                        <Setter Target="SubtitleOptionsGrid.Visibility" Value="Visible" />
                    </VisualState.Setters>
                    <Storyboard>
                        <RepositionThemeAnimation FromHorizontalOffset="224" TargetName="SubtitleOptionsGrid" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
    </Grid>
</UserControl>
